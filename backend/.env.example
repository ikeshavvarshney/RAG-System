# Comma-separated API key pools (round-robin rotation across free-tier keys)
GEMINI_API_KEYS=
TAVILY_API_KEYS=

# Vector store path (derived data, gitignored)
CHROMA_PATH=./data/chroma

# Frontend origin for CORS (never use "*")
FRONTEND_ORIGIN=http://localhost:3000

# Chunking contract (tokens)
CHUNK_MIN_TOKENS=200
CHUNK_MAX_TOKENS=800
CHUNK_TARGET_TOKENS=500

# --- OCR ---
# Tesseract is the only OCR engine.
# Path to the Tesseract binary, not the directory that holds it. A relative
# path is resolved against the repo root, not the working directory, so the
# same value works under uvicorn and under pytest. Defaults to the vendored
# copy; override for a system-wide install (e.g.
# C:\Program Files\Tesseract-OCR\tesseract.exe).
# TESSERACT_CMD=vendor/tesseract/tesseract.exe

# --- Query pipeline ---
# Flash-Lite for both query and vision: the free-tier daily cap on gemini-3.6-flash is 20 requests.
QUERY_MODEL=gemini-3.5-flash-lite
GENERATION_MODEL=gemini-3.5-flash-lite

# --- Sufficiency (best dense cosine similarity gates; the grey zone between the thresholds asks the LLM) ---
# SUFFICIENCY_HIGH_THRESHOLD=0.90
# SUFFICIENCY_LOW_THRESHOLD=0.78
# SUFFICIENCY_LLM_ENABLED=true
# SUFFICIENCY_LLM_MODEL=gemini-3.5-flash-lite
# SUFFICIENCY_LLM_TOP_K=5
# SUFFICIENCY_LLM_PASSAGE_CHARS=4000
# SUFFICIENCY_LLM_MAX_OUTPUT_TOKENS=200

# --- Web search fallback (Tavily keys go in TAVILY_API_KEYS above) ---
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_TIMEOUT_SEC=10
# WEB_SEARCH_DEPTH=basic
# WEB_SEARCH_QUERY_MAX_CHARS=400
# WEB_SEARCH_MAX_RETRIES=2
# WEB_SEARCH_BACKOFF_SEC=0.5
# WEB_SEARCH_EXHAUSTED_BLOCK_SEC=3600
# WEB_MAX_IN_POOL=5

# --- Vision & Embedding  ---
EMBEDDING_MODEL=gemini-embedding-001
VISION_MODEL=gemini-3.5-flash-lite
MAX_VISION_PAGES=80
EMBEDDING_CACHE_DIR=./data/cache/embeddings
VISION_CACHE_DIR=./data/cache/vision
OCR_CACHE_DIR=./data/cache/ocr

# DEBUG, INFO, WARNING or ERROR for the app.* loggers.
LOG_LEVEL=INFO

GROQ_EVAL_API_KEYS=PASTE_REAL_KEY_HERE
GROQ_EVAL_MODEL=llama-3.3-70b-versatile