# Comma-separated API key pools (round-robin rotation across free-tier keys)
GEMINI_API_KEYS=
TAVILY_API_KEYS=

# Vector store path (derived data, gitignored)
CHROMA_PATH=./data/chroma

# Frontend origin for CORS (never use "*")
FRONTEND_ORIGIN=http://localhost:3000

# Chunking contract (tokens)
CHUNK_MIN_TOKENS=200
CHUNK_MAX_TOKENS=800
CHUNK_TARGET_TOKENS=500

# Absolute path to the Tesseract binary. Defaults to the vendored copy at
# <repo>/vendor/tesseract/tesseract.exe; override for a system-wide install
# (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe).
# TESSERACT_CMD=

# --- Vision & Embedding  ---
EMBEDDING_MODEL=text-embedding-004
VISION_MODEL=gemini-3.6-flash
MAX_VISION_PAGES=80
EMBEDDING_CACHE_DIR=./data/cache/embeddings
VISION_CACHE_DIR=./data/cache/vision
